<configuration name="sofia.conf" description="Sofia Endpoint">
  <global_settings>
    <param name="log-level" value="0"/>
    <param name="debug-presence" value="0"/>
    <!-- <param name="auto-restart" value="false"/> -->
  </global_settings>

  <!--
    Laravel compiles active Sofia profiles into an app-managed runtime path.
    FreeSWITCH includes those generated profiles without replacing its core
    config tree under /usr/local/freeswitch/conf.
  -->
  <profiles>
    <X-PRE-PROCESS cmd="include" data="/usr/local/freeswitch/db/sip_profiles/*.xml"/>
  </profiles>
</configuration>
