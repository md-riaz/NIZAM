APP_NAME=Communications Platform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8231
APP_URL=http://localhost:8231

# Bootstrap admin used by database seeders on fresh installs.
# In production, set both ADMIN_EMAIL and ADMIN_PASSWORD before running db:seed.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TENANT_NAME=Demo Company
ADMIN_TENANT_SLUG=demo-company
ADMIN_TENANT_DOMAIN=demo.app.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=communications
DB_USERNAME=communications
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# REDIS_PASSWORD must be set in production. Leave blank to disable Redis authentication locally.
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FreeSWITCH ESL connection
FREESWITCH_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon

# FreeSWITCH XML-cURL URL (used by FreeSWITCH to fetch dialplan/directory)
FREESWITCH_XML_CURL_URL=http://localhost/freeswitch/xml-curl
FREESWITCH_LOG_PATH=/var/log/freeswitch/freeswitch.log

# Internal XML-cURL endpoint for FreeSWITCH Docker runtime.
# This value is injected into FreeSWITCH XML config by the container entrypoint at startup.
# For bare-metal deployments, FreeSWITCH's xml_curl.conf.xml must be updated manually.
FREESWITCH_XML_CURL_ENDPOINT_INTERNAL=http://nginx/freeswitch/xml-curl

# Media / NAT settings — set EXT_RTP_IP and EXT_SIP_IP to the public IP of your
# FreeSWITCH host when deploying behind NAT. Use 'auto-nat' for automatic detection.
EXT_RTP_IP=auto-nat
EXT_SIP_IP=auto-nat
RTP_PORT_RANGE_START=16384
RTP_PORT_RANGE_END=32768
DTMF_TYPE=rfc2833
# SRTP_POLICY options: optional | mandatory | disabled
SRTP_POLICY=optional

# Sanctum — comma-separated list of domains that can make stateful requests
# (e.g. dashboard domain). Required for SPA / cookie-based auth.
SANCTUM_STATEFUL_DOMAINS=localhost

# WebRTC Configuration (system-wide)
WEBRTC_ENABLED=true
WEBRTC_WSS_PORT=7443
# Public STUN server (Google's free STUN server by default)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN server for NAT traversal (leave blank if not using TURN)
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

